{
  "id": "developer-junior",
  "label": "Fejlesztő (junior)",
  "description": "Feature-fejlesztésre saját branch-en. A main/master-re tiltott push, sudo tiltott, SSH/AWS kulcsok elrejtve. Csak a saját munkakönyvtárába írhat.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(/tmp/**)",
      "Write(/tmp/**)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(pnpx:*)",
      "Bash(npx:*)",
      "Bash(turbo:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(curl:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(bash ${HOME}/marveen/scripts/agent-msg.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/fleet-api.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/sync-quarantine-allowlist.sh:*)",
      "Bash(/bin/grep:*)",
      "Bash(grep:*)",
      "Bash(bash ${HOME}/marveen/scripts/local-now.sh:*)",
      "Bash(sed -n:*)",
      "Bash(/bin/sed -n:*)",
      "Bash(head:*)",
      "Bash(/bin/head:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(tail:*)",
      "Bash(/bin/tail:*)",
      "Bash(/usr/bin/tail:*)",
      "Bash(wc:*)",
      "Bash(/usr/bin/wc:*)",
      "Bash(nl:*)",
      "Bash(/usr/bin/nl:*)",
      "Bash(cut:*)",
      "Bash(/usr/bin/cut:*)",
      "mcp__github__get_pull_request",
      "mcp__github__get_pull_request_status",
      "mcp__github__get_pull_request_files",
      "mcp__github__get_pull_request_comments",
      "mcp__github__get_pull_request_reviews",
      "mcp__github__list_pull_requests",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__get_issue",
      "mcp__github__list_issues",
      "mcp__github__search_code",
      "mcp__github__search_repositories"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf ${HOME}:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  }
}

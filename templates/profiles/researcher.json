{
  "id": "researcher",
  "label": "Kutató",
  "description": "Piackutatás, versenytárs-elemzés, webes források olvasása. Prompt injection szempontból ugyanúgy kiemelt mint a marketinges. Draft-only: riportot ír a mappájába, nem küld magától kifelé.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Write(/tmp/claude-1000/**)",
      "Read(/tmp/claude-1000/**)",
      "Read(${HOME}/Downloads/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(bash ${HOME}/marveen/scripts/agent-msg.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/fleet-api.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/sync-quarantine-allowlist.sh:*)",
      "Bash(date:*)",
      "Bash(bash ${HOME}/marveen/scripts/text-metrics.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/fb-insights.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/unas.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/local-now.sh:*)",
      "Bash(grep:*)",
      "Bash(/bin/grep:*)",
      "Bash(head:*)",
      "Bash(/bin/head:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(tail:*)",
      "Bash(/bin/tail:*)",
      "Bash(/usr/bin/tail:*)",
      "Bash(wc:*)",
      "Bash(/usr/bin/wc:*)",
      "Bash(sed -n:*)",
      "Bash(/bin/sed -n:*)",
      "Bash(cut:*)",
      "Bash(nl:*)",
      "Bash(pwd:*)",
      "Read(${HOME}/marveen/scripts/**)",
      "Bash(bash ${HOME}/marveen/scripts/jsonl.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/tsv-join.sh:*)",
      "Bash(sort:*)",
      "Bash(/usr/bin/sort:*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.env)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(curl -X POST:*)",
      "Bash(git push:*)",
      "Read(${HOME}/marveen/store/**)",
      "Bash(cat ${HOME}/marveen/store/:*)",
      "Bash(cat ${HOME}/marveen/store/*)",
      "Bash(bash ${HOME}/marveen/scripts/fb-campaign-draft.sh:*)"
    ]
  }
}

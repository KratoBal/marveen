{
  "id": "developer-senior",
  "label": "Fejlesztő (senior, bizalmi)",
  "description": "Bizalmi profil: permissive módban fut, minden parancs engedélyezve, kivéve a deny-listát (sudo, SSH/AWS/GnuPG kulcsok olvasása, force-push, rm -rf $HOME). Csak olyan ágensnek add, amit ugyanannyira megbízol mint magadat. Nem sandbox. Sandboxolt profilért lásd developer-junior.",
  "permissionMode": "permissive",
  "filesystem": {
    "allow": [],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf ${HOME}:*)",
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(/bin/sudo:*)",
      "Bash(/usr/bin/sudo:*)",
      "Bash(/bin/rm -rf ${HOME}:*)",
      "Bash(/usr/bin/rm -rf ${HOME}:*)",
      "Bash(/bin/rm -rf /:*)",
      "Bash(/usr/bin/rm -rf /:*)",
      "Bash(/bin/git push --force:*)",
      "Bash(/usr/bin/git push --force:*)",
      "Bash(/bin/git push -f:*)",
      "Bash(/usr/bin/git push -f:*)",
      "Bash(/bin/git push origin main:*)",
      "Bash(/usr/bin/git push origin main:*)",
      "Bash(/bin/git push origin master:*)",
      "Bash(/usr/bin/git push origin master:*)"
    ]
  }
}

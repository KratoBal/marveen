{
  "id": "marketer",
  "label": "Marketinges",
  "description": "Email-vázlat, hírlevél, social tartalom. Mivel webes tartalmat olvas (prompt injection felület), szigorúan korlátozott: csak a saját mappájába írhat, SSH/AWS/.env tiltva, semmilyen Bash-pusztító parancs.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(/tmp/claude-1000/**)",
      "Write(/tmp/claude-1000/**)",
      "Read(${HOME}/Downloads/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(bash ${HOME}/marveen/scripts/agent-msg.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/fleet-api.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/sync-quarantine-allowlist.sh:*)",
      "Bash(date:*)",
      "Bash(bash ${HOME}/marveen/scripts/text-metrics.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/lap-fejlec.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/local-now.sh:*)",
      "Bash(grep:*)",
      "Bash(/bin/grep:*)",
      "Bash(head:*)",
      "Bash(/bin/head:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(tail:*)",
      "Bash(/bin/tail:*)",
      "Bash(/usr/bin/tail:*)",
      "Bash(wc:*)",
      "Bash(/usr/bin/wc:*)",
      "Bash(sed -n:*)",
      "Bash(/bin/sed -n:*)",
      "Bash(cut:*)",
      "Bash(nl:*)",
      "Bash(pwd:*)",
      "Bash(/bin/ls:*)",
      "Bash(/usr/bin/ls:*)",
      "Bash(/bin/cat:*)",
      "Bash(/usr/bin/cat:*)",
      "Bash(/bin/date:*)",
      "Bash(/usr/bin/date:*)",
      "Bash(/usr/bin/grep:*)",
      "Bash(/bin/wc:*)",
      "Bash(/bin/cut:*)",
      "Bash(/usr/bin/cut:*)",
      "Bash(/bin/nl:*)",
      "Bash(/usr/bin/nl:*)",
      "Bash(/bin/pwd:*)",
      "Bash(/usr/bin/pwd:*)",
      "Read(${HOME}/marveen/scripts/**)",
      "Bash(df:*)",
      "Bash(/bin/df:*)",
      "Bash(/usr/bin/df:*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.env)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(curl -X POST:*)",
      "Bash(bash ${HOME}/marveen/scripts/fb-campaign-draft.sh:*)",
      "Bash(/bin/sudo:*)",
      "Bash(/usr/bin/sudo:*)",
      "Bash(/bin/rm:*)",
      "Bash(/usr/bin/rm:*)",
      "Bash(/bin/curl -X POST:*)",
      "Bash(/usr/bin/curl -X POST:*)"
    ]
  }
}

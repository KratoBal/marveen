{
  "id": "researcher-reader",
  "label": "Kutató (olvasó eszközökkel)",
  "description": "Ugyanaz, mint a Kutató, kiegészítve a klasszikus csak-olvasó shell eszközökkel (grep, head, tail, wc, sort, uniq, cut, sed -n, stat, md5sum) és a nevesített elemző helperekkel. Azért létezik külön profilként, mert az általános futtatási jog (python3, awk, jq) tudatosan MARAD tiltva: a jsonl.sh pont azért készült, hogy csoportosítani se kelljen kódot futtatni. Balázs 2026-08-21 08:13-kor hagyta jóvá, kifejezetten a polipra, miután egyetlen éjszaka huszonöt engedélykérés, három hamis session-stuck riasztás és két félórás üzenet-késés keletkezett abból, hogy minden olvasó lépésnél megállt.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Write(/tmp/claude-1000/**)",
      "Read(/tmp/claude-1000/**)",
      "Read(${HOME}/Downloads/**)",
      "Read(${HOME}/marveen/scripts/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(/bin/grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(sed -n:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(md5sum:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(bash ${HOME}/marveen/scripts/agent-msg.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/fleet-api.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/sync-quarantine-allowlist.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/local-now.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/jsonl.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/unas.sh:*)",
      "Bash(bash ${HOME}/marveen/scripts/text-metrics.sh:*)",
      "Bash(date:*)",
      "Bash(/bin/head:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(/bin/tail:*)",
      "Bash(/usr/bin/tail:*)",
      "Bash(/usr/bin/wc:*)",
      "Bash(/bin/sed -n:*)",
      "Bash(nl:*)",
      "Bash(pwd:*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.env)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(curl -X POST:*)",
      "Bash(git push:*)",
      "Bash(bash ${HOME}/marveen/scripts/fb-campaign-draft.sh:*)"
    ]
  }
}
